#!/usr/bin/env python3
"""
Smart Agent: Semantic Router & Multi-CLI Orchestrator for the Autonomous SDD Pipeline.
Routing is fully declarative (config/routing-policy.yaml): quotas, credit multipliers and
stage x complexity candidate chains are data, not code. Quota state is serialized with
fcntl.flock so parallel Git Worktrees never lose updates. CLI updates and the model cache
refresh run strictly out-of-band via `smart-agent --auto-update`.
Gate stages (CODE_REVIEW, QA_VISUAL, QA_FUNCTIONAL) run a persistent self-healing rejection loop
(openspec/changes/<slug>/.state.json under flock, max_retries) and QA stages get a dynamic
ephemeral QA_PORT plus mandatory process-group teardown.
"""
import sys
import os
import re
import json
import time
import fcntl
import signal
import socket
import tempfile
import contextlib
import subprocess
import urllib.request
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover
    print("❌ PyYAML is required (apt install python3-yaml).", file=sys.stderr)
    sys.exit(2)

HOME = Path.home()
QUOTA_FILE = HOME / ".pipeline_quotas.json"
LOCK_FILE = HOME / ".pipeline_quotas.lock"
MODELS_CACHE = HOME / ".cache" / "agenthub" / "models.json"
ROUTER_URL = os.environ.get("VLLM_SR_URL", "http://127.0.0.1:8080/v1/route")
COMPLEXITIES = ("TRIVIAL", "STANDARD", "COMPLEX_CODE", "DEEP_ARCH")

# Ensure user toolchains are in PATH and GitHub token is exported
env = os.environ.copy()
user_home = str(HOME)
extra_paths = [f"{user_home}/.local/bin", f"{user_home}/.cargo/bin", "/usr/local/bin"]
for p in extra_paths:
    if p not in env.get("PATH", ""):
        env["PATH"] = f"{p}:{env.get('PATH', '')}"

def _ensure_gh_token():
    """Lazily export GH_TOKEN (only needed when a CLI is actually launched)."""
    if "GH_TOKEN" not in env:
        try:
            t = subprocess.check_output(["gh", "auth", "token"], env=env, stderr=subprocess.DEVNULL).decode().strip()
            if t:
                env["GH_TOKEN"] = t
        except Exception:
            pass

# ------------------------------------------------------------------------------
# Declarative policy
# ------------------------------------------------------------------------------
def policy_path():
    candidates = [
        os.environ.get("AGENTHUB_POLICY"),
        str(HOME / ".config" / "agenthub" / "routing-policy.yaml"),
        str(Path(__file__).resolve().parent.parent / "config" / "routing-policy.yaml"),
    ]
    for c in candidates:
        if c and Path(c).is_file():
            return Path(c)
    print("❌ routing-policy.yaml not found (set AGENTHUB_POLICY or run install.sh).", file=sys.stderr)
    sys.exit(2)

def load_policy():
    policy = yaml.safe_load(policy_path().read_text())
    lim = policy["limits"]
    # Environment variables override the declared ceilings.
    lim["agy_anthropic_5h_max"] = int(os.environ.get("AGY_ANTHROPIC_5H_MAX", lim["agy_anthropic_5h_max"]))
    lim["agy_google_pro_5h_max"] = int(os.environ.get("AGY_GOOGLE_PRO_5H_MAX", lim["agy_google_pro_5h_max"]))
    lim["kiro_monthly_credits_max"] = float(os.environ.get("KIRO_MONTHLY_CREDITS_MAX", lim["kiro_monthly_credits_max"]))
    return policy

def load_models_cache():
    """Zero-latency read of the cached model catalog (empty dict if never refreshed)."""
    try:
        return json.loads(MODELS_CACHE.read_text())
    except Exception:
        return {}

# ------------------------------------------------------------------------------
# Concurrency-safe quota state (fcntl.flock around the whole read-modify-write)
# ------------------------------------------------------------------------------
def _fresh_quotas(now):
    return {"window_start": now, "agy_anthropic_5h": 0, "agy_google_pro_5h": 0, "kiro_credits_used": 0.0}

@contextlib.contextmanager
def quota_lock():
    """Exclusive POSIX lock on ~/.pipeline_quotas.lock, released on exit."""
    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(LOCK_FILE), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)

def load_quotas(window_seconds=18000):
    """Read quota state. MUST be called while holding quota_lock()."""
    now = time.time()
    try:
        data = json.loads(QUOTA_FILE.read_text())
    except Exception:
        data = _fresh_quotas(now)

    # Sliding window reset
    if now - data.get("window_start", now) > window_seconds:
        data["window_start"] = now
        data["agy_anthropic_5h"] = 0
        data["agy_google_pro_5h"] = 0
    return data

def save_quotas(data):
    """Atomically persist quota state. MUST be called while holding quota_lock()."""
    try:
        fd, tmp = tempfile.mkstemp(dir=str(QUOTA_FILE.parent), prefix=".pipeline_quotas.")
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2)
        os.replace(tmp, QUOTA_FILE)
    except Exception as e:
        print(f"⚠️ Warning: Failed to persist quota state: {e}", file=sys.stderr)

def apply_usage(quotas, policy, cand, sign=1):
    """Add (sign=1) or refund (sign=-1) one call of `cand` against the pool counters."""
    if cand["cli"] == "agy":
        pool = policy["agy"]["families"].get(cand["model"], {}).get("pool", "none")
        if pool == "anthropic":
            quotas["agy_anthropic_5h"] = max(0, quotas["agy_anthropic_5h"] + sign)
        elif pool == "google_pro":
            quotas["agy_google_pro_5h"] = max(0, quotas["agy_google_pro_5h"] + sign)
    elif cand["cli"] == "kiro":
        cost = policy["kiro"]["whitelist"][cand["model"]]
        quotas["kiro_credits_used"] = max(0.0, round(quotas["kiro_credits_used"] + sign * cost, 4))

def classify_task(prompt_text):
    """
    Classifies the incoming task by querying the vLLM Semantic Router (vllm-sr) daemon
    or falling back to a zero-latency deterministic local regex classifier (EN + PT-BR).
    """
    try:
        req = urllib.request.Request(
            ROUTER_URL,
            data=json.dumps({"text": prompt_text}).encode("utf-8"),
            headers={"Content-Type": "application/json"}
        )
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            return json.loads(resp.read().decode())
    except Exception:
        # High-precision zero-latency local heuristic fallback (Bilingual EN / PT-BR)
        ui_keywords = (
            "screen", "ui", "react", "css", "layout", "frontend", "button", "page",
            "html", "mockup", "view", "visual", "component", "tailwind", "widget",
            "tela", "botão", "botao", "pagina", "página", "componente"
        )
        complex_keywords = (
            "refactor", "architecture", "migration", "database", "security", "algorithm",
            "parallel", "concurrency", "kernel", "optimization", "thread", "distributed",
            "arquitetura", "migração", "migracao", "banco", "segurança", "seguranca",
            "algoritmo", "paralelo", "concorrência", "concorrencia", "otimização", "otimizacao"
        )
        trivial_keywords = (
            "fix typo", "typo", "readme", "comment", "checklist", "rename", "log",
            "clean", "format", "formatting",
            "corrija typo", "comentário", "comentario", "renomear", "formatar", "formatação"
        )

        text_lower = prompt_text.lower()
        has_ui = any(re.search(rf"\b{re.escape(k)}\b", text_lower) for k in ui_keywords)

        if any(re.search(rf"\b{re.escape(k)}\b", text_lower) for k in trivial_keywords):
            complexity = "TRIVIAL"
        elif any(re.search(rf"\b{re.escape(k)}\b", text_lower) for k in complex_keywords):
            complexity = "COMPLEX_CODE"
        else:
            complexity = "STANDARD"

        domain = "DOCS_ONLY"
        if has_ui or any(re.search(rf"\b{re.escape(k)}\b", text_lower) for k in ("node", "npm", "js", "ts", "typescript", "fullstack", "react", "next", "flask", "fastapi")):
            domain = "FULLSTACK_WEB"
        elif any(re.search(rf"\b{re.escape(k)}\b", text_lower) for k in ("c++", "c#", "dotnet", "gcc", "pointer", "ponteiro", "struct", "class", "algorithm", "algoritmo", "concurrency", "concorrência", "database", "banco")):
            domain = "UNIVERSITY_C_CPP_CSHARP"

        return {
            "complexity": complexity,
            "has_frontend_ui": has_ui,
            "project_domain": domain
        }

# ------------------------------------------------------------------------------
# Candidate resolution
# ------------------------------------------------------------------------------
def normalize_candidate(cand, policy):
    """Enforce the Kiro whitelist and compute the concrete runtime model id."""
    cand = dict(cand)
    if cand["cli"] == "kiro":
        wl = policy["kiro"]["whitelist"]
        model = cand["model"]
        if model not in wl:
            model = policy["kiro"]["blocked"].get(model, "auto")
        cand["model"] = model
        cand["runtime"] = model
    else:
        cand["runtime"] = f"{cand['model']}-{cand['level']}"
    return cand

def is_available(cand, policy, quotas, cache):
    """True when the candidate's pool is not saturated and the cached catalog lists it."""
    lim = policy["limits"]
    if cand["cli"] == "agy":
        known = cache.get("agy") or []
        if known and cand["runtime"] not in known:
            return False
        pool = policy["agy"]["families"].get(cand["model"], {}).get("pool", "none")
        if pool == "anthropic":
            return quotas["agy_anthropic_5h"] < lim["agy_anthropic_5h_max"]
        if pool == "google_pro":
            return quotas["agy_google_pro_5h"] < lim["agy_google_pro_5h_max"]
        return True
    known = cache.get("kiro") or []
    if known and cand["runtime"] not in known:
        return False
    return quotas["kiro_credits_used"] < lim["kiro_monthly_credits_max"]

def select_engine(stage, prompt_text, quotas, policy):
    """Pick the first available candidate of routes[stage][complexity]."""
    route = classify_task(prompt_text)
    comp = route.get("complexity", "STANDARD")
    if comp not in COMPLEXITIES:
        comp = "STANDARD"

    stage = policy.get("stage_aliases", {}).get(stage, stage)
    if stage not in policy["routes"]:
        stage = policy["default_stage"]
    chain = [normalize_candidate(c, policy) for c in policy["routes"][stage][comp]]

    cache = load_models_cache()
    for cand in chain:
        if is_available(cand, policy, quotas, cache):
            return cand, route
    # Every pool saturated: last-resort is the unmetered head of the chain's agy entries.
    return next((c for c in chain if c["cli"] == "agy"), chain[0]), route

# ------------------------------------------------------------------------------
# Out-of-band maintenance (never on the task critical path)
# ------------------------------------------------------------------------------
def auto_update():
    """Update agy/kiro-cli and atomically refresh ~/.cache/agenthub/models.json."""
    def sh(cmd):
        try:
            r = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=300)
            return r.stdout + r.stderr
        except Exception as e:
            print(f"   ⚠️ {' '.join(cmd)}: {e}", file=sys.stderr)
            return ""

    print("🔄 [auto-update] Updating CLIs...")
    sh(["kiro-cli", "update", "-y"])
    sh(["agy", "update"])

    print("🔄 [auto-update] Refreshing model cache...")
    agy_ids = sorted(set(re.findall(r"\b(?:gemini|claude)[a-z0-9.\-]*-(?:low|medium|high)\b", sh(["agy", "models"]))))
    kiro_ids = sorted(set(re.findall(r"\b(?:claude-[a-z0-9.\-]+|auto)\b", sh(["kiro-cli", "chat", "--list-models"]))))
    cache = load_models_cache()
    if agy_ids:
        cache["agy"] = agy_ids
    if kiro_ids:
        cache["kiro"] = kiro_ids
    cache["updated_at"] = int(time.time())

    MODELS_CACHE.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(MODELS_CACHE.parent), prefix=".models.")
    with os.fdopen(fd, "w") as f:
        json.dump(cache, f, indent=2)
    os.replace(tmp, MODELS_CACHE)
    print(f"✅ [auto-update] Cache written: {MODELS_CACHE} (agy={len(cache.get('agy', []))}, kiro={len(cache.get('kiro', []))})")

# ------------------------------------------------------------------------------
# Active change binding, agents and CLI command construction
# ------------------------------------------------------------------------------
GATE_REPORTS = {"CODE_REVIEW": "code-review-report.md", "QA_VISUAL": "qa-report.md", "QA_FUNCTIONAL": "qa-report.md"}
VERDICT_RE = re.compile(r"STATUS:\s*(APPROVED|REJECTED)", re.IGNORECASE)

def resolve_slug(explicit=None):
    """Active change slug: --slug, $AGENTHUB_CHANGE, else the most recent openspec/changes/<slug>/."""
    slug = explicit or os.environ.get("AGENTHUB_CHANGE")
    if slug:
        return slug
    root = Path("openspec/changes")
    if not root.is_dir():
        return None
    dirs = [d for d in root.iterdir() if d.is_dir() and d.name != "archive"]
    if not dirs:
        return None
    return max(dirs, key=lambda d: d.stat().st_mtime).name

def spec_binding(slug):
    """Prompt block that explicitly binds the agent to the active change directory."""
    if slug:
        return (f"\n\n[ACTIVE SPEC]: `openspec/changes/{slug}/` is the single source of truth for this task "
                f"(proposal.md, context-map.md, specs/, tasks.md, reports). Read and write artifacts only there.")
    return ("\n\n[ACTIVE SPEC]: derive a kebab-case <slug> from the card title and use "
            "`openspec/changes/<slug>/` as the single source of truth for this task.")

def build_cmd(cand, prompt, agent=None):
    if cand["cli"] == "agy":
        cmd = ["agy", "-p", prompt, "--model", cand["runtime"], "--dangerously-skip-permissions"]
        if agent:
            cmd += ["--agent", agent]
        return cmd
    cmd = ["kiro-cli", "chat", "--no-interactive", "--trust-all-tools", "--trust-workspace", "--model", cand["runtime"]]
    if agent:
        cmd += ["--agent", agent]
    return cmd + [prompt]

# ------------------------------------------------------------------------------
# QA: dynamic ephemeral port + mandatory process-group teardown
# ------------------------------------------------------------------------------
def alloc_free_port():
    """Ask the kernel for a free ephemeral TCP port (never the common dev ports)."""
    while True:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.bind(("127.0.0.1", 0))
            port = s.getsockname()[1]
        if port not in (3000, 5000, 8000):
            return port

def listening_pids(port):
    """PIDs listening on `port` (via ss, falling back to lsof)."""
    pids = set()
    try:
        out = subprocess.run(["ss", "-H", "-ltnp", f"sport = :{port}"], capture_output=True, text=True, timeout=5).stdout
        pids |= {int(p) for p in re.findall(r"pid=(\d+)", out)}
    except Exception:
        pass
    if not pids:
        try:
            out = subprocess.run(["lsof", "-t", f"-iTCP:{port}", "-sTCP:LISTEN"], capture_output=True, text=True, timeout=5).stdout
            pids |= {int(p) for p in out.split()}
        except Exception:
            pass
    pids.discard(os.getpid())
    return pids

def teardown(pgid, port):
    """Kill the isolated process group, then anything still listening on QA_PORT."""
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(pgid, sig)
        except (ProcessLookupError, PermissionError):
            pass
        deadline = time.time() + 3
        while sig == signal.SIGTERM and time.time() < deadline:
            try:
                os.killpg(pgid, 0)
            except (ProcessLookupError, PermissionError):
                break
            time.sleep(0.1)
    for pid in listening_pids(port):
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass

def run_proc(cmd, extra_env=None, qa_port=None):
    """Run a CLI. For QA, isolate it in its own session and always tear it down."""
    penv = dict(env)
    penv.update(extra_env or {})
    if qa_port is None:
        return subprocess.run(cmd, env=penv).returncode
    proc = subprocess.Popen(cmd, env=penv, start_new_session=True)
    try:
        return proc.wait()
    finally:
        teardown(proc.pid, qa_port)

# ------------------------------------------------------------------------------
# Persistent rejection-loop state: openspec/changes/<slug>/.state.json (under flock)
# ------------------------------------------------------------------------------
@contextlib.contextmanager
def state_lock(change_dir):
    fd = os.open(str(change_dir / ".state.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)

def load_state(change_dir, max_retries):
    try:
        st = json.loads((change_dir / ".state.json").read_text())
    except Exception:
        st = {}
    st.setdefault("status", "IN_PROGRESS")
    st.setdefault("retry_count", 0)
    st["max_retries"] = max_retries
    st.setdefault("history", [])
    return st

def save_state(change_dir, st):
    fd, tmp = tempfile.mkstemp(dir=str(change_dir), prefix=".state.")
    with os.fdopen(fd, "w") as f:
        json.dump(st, f, indent=2)
    os.replace(tmp, change_dir / ".state.json")

def read_verdict(report):
    """Return 'APPROVED' / 'REJECTED' from the last STATUS line, or None if absent."""
    try:
        found = VERDICT_RE.findall(report.read_text())
    except Exception:
        return None
    return found[-1].upper() if found else None

def zero_token_validate(cwd="."):
    """Deterministic local compiler/test gate run between APPLY retries (no LLM tokens)."""
    custom = os.environ.get("AGENTHUB_VALIDATE_CMD")
    if custom:
        cmds = [custom]
    else:
        cmds = []
        root = Path(cwd)
        if (root / "tsconfig.json").exists():
            cmds.append("npx tsc --noEmit")
        if (root / "package.json").exists():
            cmds.append("npm test --if-present")
        if (root / "pyproject.toml").exists() or (root / "pytest.ini").exists():
            cmds.append("pytest -q")
        if (root / "Makefile").exists():
            cmds.append("make test")
    for c in cmds:
        print(f"🧪 [Zero-Token Gate] {c}")
        if subprocess.run(c, shell=True, env=env, cwd=cwd).returncode != 0:
            print(f"⚠️ Zero-Token Gate failed: {c}", file=sys.stderr)
            return False
    return True

# ------------------------------------------------------------------------------
# Single stage execution (select + reserve + run + refund + fallback cascade)
# ------------------------------------------------------------------------------
def execute_stage(stage, agent, prompt, policy, dry_run=False, qa_port=None):
    """Returns (success, route_meta). Quota state is mutated only under quota_lock()."""
    with quota_lock():
        quotas = load_quotas(policy["limits"]["window_seconds"])
        cand, route_meta = select_engine(stage, prompt, quotas, policy)
        if not dry_run:
            apply_usage(quotas, policy, cand)
            save_quotas(quotas)

    cli, actual_model = cand["cli"], cand["runtime"]
    if stage in ["SPEC", "BRIEFING"] and route_meta.get("has_frontend_ui"):
        prompt += (
            "\n\n[ACTIVE UI RULE]: This task has visual frontend impact. "
            "In addition to the standard OpenSpec artifacts, you MUST create a self-contained interactive prototype "
            "at `openspec/changes/<id>/ui-mockup.html` (using Tailwind CSS via CDN) for human visual approval."
        )

    print(f"⚡ [Smart-Agent Router] Stage={stage} | Agent={agent or '-'} | Complexity={route_meta.get('complexity')} | Domain={route_meta.get('project_domain')} | UI={route_meta.get('has_frontend_ui')} -> CLI={cli} ({actual_model})")

    if dry_run:
        print(f"[DRY-RUN] Simulation completed successfully. Selected CLI: {cli}, Model: {actual_model}")
        return True, route_meta

    _ensure_gh_token()
    extra = {"QA_PORT": str(qa_port)} if qa_port else {}
    if qa_port:
        prompt += (f"\n\n[QA_PORT]: bind every server you start to the free port {qa_port} (`$QA_PORT`). "
                   "Never use :3000, :5000 or :8000. Terminate every process you spawn before exiting.")

    if run_proc(build_cmd(cand, prompt, agent), extra, qa_port) == 0:
        return True, route_meta

    # Refund the reservation: the call failed.
    with quota_lock():
        quotas = load_quotas(policy["limits"]["window_seconds"])
        apply_usage(quotas, policy, cand, sign=-1)
        save_quotas(quotas)

    # Cascading fallback if primary CLI hits rate limits or fails
    fb = normalize_candidate(policy["fallback"]["tier1"], policy)
    print(f"⚠️ Primary CLI failed or hit rate limit. Triggering Tier-1 Fallback (AWS Kiro CLI - {fb['runtime']})...")
    if run_proc(build_cmd(fb, prompt, agent), extra, qa_port) == 0:
        with quota_lock():
            quotas = load_quotas(policy["limits"]["window_seconds"])
            apply_usage(quotas, policy, fb)
            save_quotas(quotas)
        return True, route_meta
    print("⚠️ Tier-1 Fallback failed. Triggering Tier-2 Emergency Fallback (GitHub Copilot CLI)...")
    return run_proc(["copilot", "-p", prompt, "-s", "--allow-all"], extra, qa_port) == 0, route_meta

# ------------------------------------------------------------------------------
# Gate stages: self-healing rejection loop
# ------------------------------------------------------------------------------
def run_gate(stage, agent, prompt, policy, slug):
    """Run CODE_REVIEW / QA_*; on REJECTED, re-run code-craftsman (APPLY) up to max_retries."""
    change_dir = Path("openspec/changes") / slug
    if not change_dir.is_dir():
        print(f"❌ {change_dir}/ not found.", file=sys.stderr)
        return 2
    report = change_dir / GATE_REPORTS[stage]
    max_retries = int(policy.get("orchestration", {}).get("max_retries", 2))
    apply_agent = policy.get("stage_agents", {}).get("APPLY", "code-craftsman")

    while True:
        report.unlink(missing_ok=True)  # never trust a stale verdict
        qa_port = alloc_free_port() if stage.startswith("QA_") else None
        ok, _ = execute_stage(stage, agent, prompt, policy, qa_port=qa_port)
        verdict = read_verdict(report) if ok else None
        if ok and verdict == "APPROVED":
            with state_lock(change_dir):
                st = load_state(change_dir, max_retries)
                st["status"] = f"{stage}_APPROVED"
                st["history"].append({"gate": stage, "verdict": "APPROVED", "ts": int(time.time())})
                save_state(change_dir, st)
            print(f"✅ [{stage}] STATUS: APPROVED")
            return 0

        reason = verdict or ("NO_VERDICT" if ok else "AGENT_FAILED")
        with state_lock(change_dir):
            st = load_state(change_dir, max_retries)
            st["history"].append({"gate": stage, "verdict": reason, "ts": int(time.time())})
            if st["retry_count"] >= max_retries:
                st["status"] = "HALTED_FOR_HUMAN"
                save_state(change_dir, st)
                print(f"🛑 [{stage}] rejected ({reason}) and retry_count={st['retry_count']} >= {max_retries}: HALTED_FOR_HUMAN", file=sys.stderr)
                return 1
            st["retry_count"] += 1
            st["status"] = f"RETRYING_{stage}"
            save_state(change_dir, st)
            attempt = st["retry_count"]

        defects = report.read_text() if report.exists() else f"(gate produced no report; reason: {reason})"
        print(f"🔁 [{stage}] {reason}: self-healing attempt {attempt}/{max_retries} via {apply_agent} (APPLY)")
        fix_prompt = (
            f"[REJECTION REPORT from {stage}] Fix every defect below in the application code, "
            f"re-run the local Zero-Token gate until it exits 0, and do NOT edit `openspec/changes/{slug}/specs/`.\n\n"
            f"{defects}" + spec_binding(slug)
        )
        execute_stage("APPLY", apply_agent, fix_prompt, policy)
        zero_token_validate()

def parse_args(argv):
    opts = {"dry_run": False, "agent": None, "slug": None, "reset_state": False}
    pos = []
    it = iter(argv)
    for a in it:
        if a == "--dry-run":
            opts["dry_run"] = True
        elif a == "--reset-state":
            opts["reset_state"] = True
        elif a == "--agent":
            opts["agent"] = next(it, None)
        elif a == "--slug":
            opts["slug"] = next(it, None)
        else:
            pos.append(a)
    return opts, pos

def run():
    if "--auto-update" in sys.argv:
        auto_update()
        return

    opts, args = parse_args(sys.argv[1:])
    stage = args[0] if len(args) > 0 else "STANDARD"
    prompt = args[1] if len(args) > 1 else (sys.stdin.read() if not sys.stdin.isatty() else "")

    if not prompt:
        print("Usage: smart-agent [--dry-run] [--agent NAME] [--slug SLUG] [--reset-state] <STAGE> '<prompt>' or via stdin | smart-agent --auto-update", file=sys.stderr)
        sys.exit(1)

    policy = load_policy()
    slug = resolve_slug(opts["slug"])

    # `QA` auto-dispatches: QA_VISUAL when the change has a UI (ui-mockup.html or UI signals), else QA_FUNCTIONAL.
    if stage == "QA":
        mockup = slug and (Path("openspec/changes") / slug / "ui-mockup.html").exists()
        has_ui = bool(mockup) or bool(classify_task(prompt).get("has_frontend_ui"))
        stage = "QA_VISUAL" if has_ui else "QA_FUNCTIONAL"
    stage = policy.get("stage_aliases", {}).get(stage, stage)
    agent = opts["agent"] or policy.get("stage_agents", {}).get(stage)

    if slug and stage in policy.get("stage_agents", {}):
        prompt += spec_binding(slug)
    elif stage in policy.get("stage_agents", {}):
        prompt += spec_binding(None)

    if stage in GATE_REPORTS and not opts["dry_run"]:
        if not slug:
            print("❌ Gate stages need an active change: pass --slug or create openspec/changes/<slug>/.", file=sys.stderr)
            sys.exit(2)
        if opts["reset_state"]:
            cd = Path("openspec/changes") / slug
            with state_lock(cd):
                (cd / ".state.json").unlink(missing_ok=True)
        sys.exit(run_gate(stage, agent, prompt, policy, slug))

    ok, _ = execute_stage(stage, agent, prompt, policy, dry_run=opts["dry_run"])
    sys.exit(0 if ok or opts["dry_run"] else 1)

if __name__ == "__main__":
    run()
